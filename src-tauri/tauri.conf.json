{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cukcoo ENARM Aris",
  "version": "1.0.0",
  "identifier": "com.aristeo.cukcoo-enarm-aris",
  "build": {
    "frontendDist": "https://aristeovaladezmontero-coder.github.io/reloj/"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Cukcoo ENARM Aris",
        "url": "https://aristeovaladezmontero-coder.github.io/reloj/?sala=M7AF",
        "width": 360,
        "height": 550,
        "resizable": false,
        "decorations": false,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "transparent": true,
        "shadow": true,
        "windowEffects": {
          "effects": ["hudWindow"],
          "state": "active",
          "radius": 22
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.icns", "icons/icon.png"]
  }
}
